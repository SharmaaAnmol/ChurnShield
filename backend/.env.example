# ChurnShield Backend Environment Configuration
# On Render: PORT is automatically injected by the platform.
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated list of frontend domains)
# Example for local development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
# Example for production on Vercel:
# ALLOWED_ORIGINS=https://churnshield.vercel.app,http://localhost:5173

# Optional Artifact Directory Override (defaults to backend/artifacts)
# ARTIFACT_DIR=artifacts

